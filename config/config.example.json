    "stt_prompt": "Джарвис, открой браузер. Джарвис, статус систем. Джарвис, VS Code. Джарвис, Copilot. Джарвис, который час.",
    "stt_language": "ru",
    "stt_noise_adapt_k": 3.0,
    "stt_noise_max_ratio": 8.0,

    "chat_mode": "tasks",
    "transcript_preview": false,

    "audio_sample_rate": 16000,
    "silence_threshold": 0.005,
