{
    "jarvis_name": "JARVIS",

    "wake_words": [
        "джарвис",
        "jarvis",
        "джарвиз",
        "дарвис"
    ],

    "require_wake_word": false,
    "wake_word_cooldown": 1.5,
    "wake_ack": "Слушаю, сэр.",
    "follow_up_seconds": 8.0,

    "persona": {
        "name": "JARVIS",
        "address": "сэр",
        "humor": "subtle",
        "verbosity": "concise",
        "language": "ru"
    },

    "groq_api_key": "",
    "groq_model": "whisper-large-v3-turbo",
    "deepseek_api_key": "",
