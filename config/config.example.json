    "max_speech_seconds": 12.0,
    "silence_duration": 0.7,
    "initial_silence_seconds": 1.2,

    "use_llm": true,

    "llm_model": "deepseek-chat",
    "vision_model": "qwen/qwen3.8-27b",
    "llm_history_size": 20,

    "stt_local_model": "",
    "stt_local_device": "cpu",
    "stt_local_compute_type": "int8",

    "llm": {
        "provider": "deepseek",
        "base_url": "",
        "api_key": "",
        "model": "deepseek-chat",
        "enabled": true,
        "fallback_base_url": "",
        "fallback_model": "",
        "fallback_api_key": "",
        "auto_fallback": true,
        "max_retries": 2,
        "retry_backoff": 0.8,
        "parallel_tool_calls": false,
        "request_timeout": 180,
        "session_history": 20
    },

    "memory_size": 50,

    "tts_rate": 185,
    "tts_voice": "en-US-AndrewMultilingualNeural",
    "tts_pitch": "-8Hz",
    "tts_voices": [
        "en-US-AndrewMultilingualNeural"
    ],
    "tts_offline_fallback": false,

    "agent": {
        "autonomy": "balanced",
        "max_iterations": 12,
